{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": [
    "@typescript-eslint",
    "react-hooks"
  ],
  "rules": {
    "no-restricted-syntax": [
      "error",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}/]",
        "message": "Hardcoded hex color literal — import a token from lib/design-tokens.ts instead."
      },
      {
        "selector": "TemplateElement[value.raw=/#[0-9a-fA-F]{3,8}/]",
        "message": "Hardcoded hex color literal — import a token from lib/design-tokens.ts instead."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "components/admin/**",
        "app/admin/**",
        "components/landing/**",
        "lib/design-tokens.ts",
        "tailwind.config.ts",
        "lib/report/**",
        "scripts/**"
      ],
      "rules": {
        "no-restricted-syntax": "off"
      }
    },
    {
      "files": [
        "app/(app)/customers/[[]customerId[]]/page.tsx",
        "app/(app)/customers/page.tsx",
        "app/(app)/inventory/[[]vehicleId[]]/checkpoint/[[]direction[]]/page.tsx",
        "app/(app)/inventory/[[]vehicleId[]]/comparison/page.tsx",
        "app/(app)/inventory/[[]vehicleId[]]/page.tsx",
        "app/(app)/layout.tsx",
        "app/(app)/lot-billing/[[]groupId[]]/page.tsx",
        "app/(app)/profile/page.tsx",
        "app/(app)/settings/branding/page.tsx",
        "app/(app)/settings/page.tsx",
        "app/(app)/storage/dispatch/page.tsx",
        "app/(app)/storage/locations/page.tsx",
        "app/(app)/storage/overview/page.tsx",
        "app/(app)/vehicles/intake/page.tsx",
        "app/changelog/page.tsx",
        "app/complete/[[]token[]]/page.tsx",
        "app/fleet/inspect/[[]token[]]/page.tsx",
        "app/inspect/[[]token[]]/page.tsx",
        "app/invoice/[[]token[]]/page.tsx",
        "app/page.tsx",
        "app/scan/[[]token[]]/page.tsx",
        "components/billing/billing-dashboard.tsx",
